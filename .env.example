# Copy to .env (git-ignored) and adjust. Real environment variables win.

# Password for the instructor pages at /instructor (at least 10 characters).
# Leave unset to disable instructor access entirely.
INSTRUCTOR_PASSWORD=

# OpenAI API key for "Write questions with AI" in the exam editor
# (platform.openai.com). Leave unset to disable AI question writing.
OPENAI_API_KEY=
# Optional: which OpenAI model writes questions (default gpt-5.5).
# AI_MODEL=gpt-5.5

# Classes students choose from on the start screen (comma-separated).
# Leave unset to let students type their class instead.
# CLASS_LIST=CS120-01,CS120-02

# Run the sample exam with exam-mode rules instead of practice mode.
# SAMPLE_EXAM_MODE=exam
