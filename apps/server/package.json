{
  "name": "@linuxlab/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --include ../../.env src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p .",
    "smoke:containers": "tsx scripts/smoke-containers.ts",
    "smoke:terminal": "tsx scripts/smoke-terminal.ts",
    "smoke:grading": "tsx scripts/smoke-grading.ts",
    "smoke:scoring": "tsx scripts/smoke-scoring.ts",
    "smoke:commands": "tsx scripts/smoke-commands.ts",
    "smoke:instructor": "tsx scripts/smoke-instructor.ts",
    "smoke:security": "tsx scripts/smoke-security.ts",
    "smoke:lock": "tsx scripts/smoke-lock.ts",
    "smoke:tries": "tsx scripts/smoke-tries.ts",
    "smoke:authoring": "tsx scripts/smoke-authoring.ts",
    "commands:show": "tsx scripts/show-commands.ts",
    "ai:try": "tsx scripts/try-generate.ts",
    "containers:cleanup": "tsx scripts/cleanup-containers.ts"
  },
  "dependencies": {
    "dockerode": "^5.0.1",
    "express": "^5.2.1",
    "openai": "^7.23.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.15"
  }
}
